# Skopiuj do .env (lokalnie) albo wpisz w zmiennych środowiskowych aplikacji na Hostingerze.

NODE_ENV=production
PORT=3000

# --- Panel właściciela (/panel) ---
# Hasło logowania. Bez niego panel nikogo nie wpuści.
PANEL_PASSWORD=
# Losowy sekret do podpisywania sesji, np. wynik `openssl rand -hex 32`.
PANEL_SECRET=

# --- Baza danych ---
# Hostinger: baza MySQL z hPanelu. Z aplikacji łączymy się przez 127.0.0.1, nie przez srvNNNN.hstgr.io.
# Przykład: mysql://u123_oberza:HASLO@127.0.0.1:3306/u123_oberza
# Puste = plik SQLite w DATA_DIR (wystarczy lokalnie i na własnym serwerze).
DATABASE_URL=
DATA_DIR=data

# --- Powiadomienia o nowych zamówieniach i rezerwacjach (opcjonalne) ---
# Adres, na który przychodzą powiadomienia, i dane skrzynki nadawczej (np. skrzynka w Hostinger Mail).
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Webhook (Make, n8n, Slack, Telegram przez bota itp.) — dostaje JSON z tytułem i treścią.
NOTIFY_WEBHOOK_URL=

# Publiczny adres strony (do linku w powiadomieniach), np. https://karczmaoberza.pl
PUBLIC_URL=

# --- Inne ---
# Po ilu dniach usuwać dane osobowe z zamówień i rezerwacji (RODO). 0 = nigdy.
RETENTION_DAYS=180
# Liczba pośredników (proxy) przed aplikacją. Na Hostingerze zostaw 1.
TRUST_PROXY=1
# Dodatkowe domeny, z których wolno wysyłać formularze (np. stara domena w okresie przejściowym).
ALLOWED_ORIGINS=
